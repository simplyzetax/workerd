using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "response-json-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "response-json-test.js")
        ],
        bindings = [(name = "pedantic", json = "false")],
        compatibilityFlags = ["nodejs_compat"],
      )
    ),
    ( name = "response-json-pedantic-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "response-json-test.js")
        ],
        bindings = [(name = "pedantic", json = "true")],
        compatibilityFlags = ["nodejs_compat", "pedantic_wpt"],
      )
    ),
  ],
);
